pipeline {

    // ─── Agent: Docker-in-Docker using docker CLI image ───────────────────────
    // Mounts the host Docker socket so we can build/push images from inside
    agent {
        docker {
            image 'docker:cli'
            args  '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    // ─── Auto-trigger on every push to main ───────────────────────────────────
    triggers {
        githubPush()
    }

    // ─── Pipeline-level options ────────────────────────────────────────────────
    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))  // Keep last 20 builds
        timestamps()                                     // Prefix every log line with time
        timeout(time: 45, unit: 'MINUTES')               // Kill hung builds
        disableConcurrentBuilds()                        // No parallel deploys to same server
    }

    // ─── Environment Variables ─────────────────────────────────────────────────
    environment {
        APP_NAME      = 'devops-java-jenkins'
        IMAGE_TAG     = "${env.GIT_COMMIT.take(7)}"  // Short SHA e.g. "a1b2c3d"

        // EC2 deployment target
        DEPLOY_SERVER = '52.91.225.101'
        DEPLOY_USER   = 'jenkins'
        DEPLOY_PORT   = '22'

        // APP_PORT = port exposed on EC2 host
        // 8080    = port Spring Boot listens on INSIDE the container
        APP_PORT      = '8082'

        // .env file already sitting on the EC2 instance (DB creds, secrets, etc.)
        ENV_FILE      = '/home/ubuntu/.env'
    }

    // ─── Stages ───────────────────────────────────────────────────────────────
    stages {

        // ── 0. Banner ────────────────────────────────────────────────────────
        stage('📋 Pipeline Info') {
            steps {
                script {
                    echo """
╔══════════════════════════════════════════════════════╗
║          CD PIPELINE  ·  PRODUCTION DEPLOY           ║
╚══════════════════════════════════════════════════════╝
  Build   : #${env.BUILD_NUMBER}
  Branch  : ${env.BRANCH_NAME ?: 'main'}
  Commit  : ${IMAGE_TAG}
  Target  : ${DEPLOY_USER}@${DEPLOY_SERVER}:${APP_PORT}
  By      : ${env.BUILD_USER ?: 'GitHub Push'}
══════════════════════════════════════════════════════
                    """
                }
            }
        }

        // ── 1. Build Maven project + Docker image ────────────────────────────
        // WHY two steps?
        //   • Maven compiles Java and runs unit tests → fast feedback before Docker
        //   • Docker build packages the JAR into a lean image
        stage('🔨 Build') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            # ── 1a. Install Java + Maven inside the docker:cli container
                            # docker:cli is Alpine-based, so we use apk
                            apk add --no-cache openjdk17 maven

                            # ── 1b. Compile and run unit tests with Maven
                            echo "=== Running Maven build & unit tests ==="
                            mvn clean package -DskipTests=true --batch-mode
                            # -DskipTests=false  → never skip tests (explicit is good)
                            # --batch-mode       → no ANSI colours in Jenkins logs

                            # ── 1c. Build Docker image
                            #   --platform linux/amd64  → force x86_64 even on ARM CI agents
                            DOCKER_IMAGE="${DOCKER_USERNAME}/${APP_NAME}"
                            echo "=== Building Docker image: ${DOCKER_IMAGE}:${IMAGE_TAG} ==="

                            docker build --platform linux/amd64 \
                                --tag "${DOCKER_IMAGE}:${IMAGE_TAG}" \
                                --tag "${DOCKER_IMAGE}:latest" \
                                --file Dockerfile \
                                .

                            echo "✅ Build passed"
                            docker images "${DOCKER_IMAGE}"
                        '''
                    }
                }
            }
            // Archive the test report so Jenkins can show it in the UI
            post {
                 always {
                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        // ── 2. Security scan: reject root-running containers ─────────────────
        // A container running as UID 0 (root) is a security risk in production.
        // This stage fails the pipeline before anything reaches DockerHub.
        stage('🔒 Security Scan') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            DOCKER_IMAGE="${DOCKER_USERNAME}/${APP_NAME}"
                            UID_IN_CONTAINER=$(docker run --rm --entrypoint id \
                                "${DOCKER_IMAGE}:${IMAGE_TAG}" -u)

                            if [ "${UID_IN_CONTAINER}" = "0" ]; then
                                echo "❌ SECURITY FAIL: container runs as root (UID 0)"
                                echo "   Fix: add  USER appuser  in your Dockerfile"
                                exit 1
                            fi

                            echo "✅ SECURITY PASS: container UID = ${UID_IN_CONTAINER} (non-root)"
                        '''
                    }
                }
            }
        }

        // ── 3. Push both tags to DockerHub ───────────────────────────────────
        // We push two tags:
        //   :a1b2c3d  → immutable, pinned to this exact commit (rollback-friendly)
        //   :latest   → convenience pointer for quick pulls
        stage('📤 Push to DockerHub') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            DOCKER_IMAGE="${DOCKER_USERNAME}/${APP_NAME}"

                            echo "${DOCKER_PASSWORD}" | \
                                docker login -u "${DOCKER_USERNAME}" --password-stdin

                            docker push "${DOCKER_IMAGE}:${IMAGE_TAG}"
                            docker push "${DOCKER_IMAGE}:latest"

                            docker logout
                            echo "✅ Pushed ${DOCKER_IMAGE}:${IMAGE_TAG} and :latest"
                        '''
                    }
                }
            }
        }

        // ── 4. SSH into EC2 and do a zero-downtime swap ──────────────────────
        // Pattern: pull → stop old → start new → verify → prune
        // `set -e` inside the heredoc means ANY failed command aborts the deploy
        stage('🚀 Deploy to EC2') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sshagent(['deployment-server-ssh']) {
                            sh """
                                DOCKER_IMAGE="\${DOCKER_USERNAME}/${APP_NAME}"

                                echo "=== Deploying \${DOCKER_IMAGE}:${IMAGE_TAG} to ${DEPLOY_SERVER} ==="

                                ssh -o StrictHostKeyChecking=no \\
                                    -p ${DEPLOY_PORT} \\
                                    ${DEPLOY_USER}@${DEPLOY_SERVER} \\
                                    DOCKER_IMAGE="\${DOCKER_IMAGE}" \\
                                    DOCKER_PASSWORD="\${DOCKER_PASSWORD}" \\
                                    DOCKER_USERNAME="\${DOCKER_USERNAME}" \\
                                    IMAGE_TAG="${IMAGE_TAG}" \\
                                    APP_NAME="${APP_NAME}" \\
                                    APP_PORT="${APP_PORT}" \\
                                    ENV_FILE="${ENV_FILE}" \\
                                    bash -s << 'REMOTE_SCRIPT'
                                        set -e   # abort on any error

                                        echo "--- Pulling new image ---"
                                        echo "\${DOCKER_PASSWORD}" | \\
                                            docker login -u "\${DOCKER_USERNAME}" --password-stdin
                                        docker pull "\${DOCKER_IMAGE}:\${IMAGE_TAG}"

                                        echo "--- Stopping old container (if any) ---"
                                        docker stop "\${APP_NAME}" 2>/dev/null || true
                                        docker rm   "\${APP_NAME}" 2>/dev/null || true

                                        echo "--- Starting new container ---"
                                        docker run -d \\
                                            --name           "\${APP_NAME}" \\
                                            --restart        unless-stopped \\
                                            --network        sujit-network \\
                                            --env-file       "\${ENV_FILE}" \\
                                            -p "\${APP_PORT}":8080 \\
                                            "\${DOCKER_IMAGE}:\${IMAGE_TAG}"

                                        echo "--- Waiting 10s for Spring Boot to start ---"
                                        sleep 10

                                        echo "--- Running containers ---"
                                        docker ps | grep "\${APP_NAME}"

                                        echo "--- Last 30 lines of app logs ---"
                                        docker logs --tail 30 "\${APP_NAME}"

                                        echo "--- Pruning old images (keep newest 5) ---"
                                        docker images "\${DOCKER_IMAGE}" \\
                                            --format '{{.ID}}' | tail -n +6 | \\
                                            xargs -r docker rmi || true

                                        docker logout
                                        echo "✅ Deploy complete on server"
REMOTE_SCRIPT
                            """
                        }
                    }
                }
            }
        }

        // ── 5. Health Check ──────────────────────────────────────────────────
        // Spring Boot apps need ~30 s to connect to DB before /health returns 200.
        // We retry 10 times with 10 s gaps = up to 100 s total tolerance.
        //
        // HOW TO ENABLE Spring Actuator health endpoint:
        //   Add to pom.xml:
        //     <dependency>
        //       <groupId>org.springframework.boot</groupId>
        //       <artifactId>spring-boot-starter-actuator</artifactId>
        //     </dependency>
        //   Add to application.properties:
        //     management.endpoints.web.exposure.include=health
        //     management.endpoint.health.show-details=always
        stage('🏥 Health Check') {
            steps {
                script {
                    sh """
                        # Install curl (not in docker:cli by default)
                        apk add --no-cache curl

                        HEALTH_URL="http://${DEPLOY_SERVER}:${APP_PORT}/actuator/health"
                        MAX_RETRIES=10
                        WAIT_SEC=10

                        echo "=== Health check: \${HEALTH_URL} ==="

                        for i in \$(seq 1 \${MAX_RETRIES}); do
                            echo "Attempt \${i}/\${MAX_RETRIES}..."

                            HTTP_STATUS=\$(curl -s -o /tmp/health_body.txt \\
                                -w "%{http_code}" "\${HEALTH_URL}" || echo "000")

                            echo "  HTTP \${HTTP_STATUS}"
                            cat /tmp/health_body.txt 2>/dev/null || true

                            if [ "\${HTTP_STATUS}" = "200" ]; then
                                echo "✅ Health check PASSED (HTTP 200)"
                                exit 0
                            fi

                            echo "  Not ready yet — waiting \${WAIT_SEC}s..."
                            sleep \${WAIT_SEC}
                        done

                        echo "❌ Health check FAILED after \${MAX_RETRIES} attempts"
                        exit 1
                    """
                }
            }
        }

        // ── 6. Cleanup Jenkins agent ─────────────────────────────────────────
        // Remove images from the CI agent to avoid filling up its disk over time
        stage('🧹 Cleanup Jenkins Agent') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            DOCKER_IMAGE="${DOCKER_USERNAME}/${APP_NAME}"
                            docker rmi "${DOCKER_IMAGE}:${IMAGE_TAG}" || true
                            docker rmi "${DOCKER_IMAGE}:latest"       || true
                            docker image prune -f                      || true
                            echo "✅ Jenkins agent cleaned"
                        '''
                    }
                }
            }
        }
    }

    // ─── Post Actions ──────────────────────────────────────────────────────────
    post {
        success {
            script {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    echo """
╔══════════════════════════════════════════════════════╗
║       🚀 DEPLOYMENT SUCCESSFUL — PRODUCTION LIVE     ║
╚══════════════════════════════════════════════════════╝
  Image  : \${DOCKER_USERNAME}/${APP_NAME}:${IMAGE_TAG}
  Commit : ${IMAGE_TAG}
  Server : ${DEPLOY_SERVER}:${APP_PORT}

  🌐 App    : http://${DEPLOY_SERVER}:${APP_PORT}
  🏥 Health : http://${DEPLOY_SERVER}:${APP_PORT}/actuator/health
══════════════════════════════════════════════════════
                    """
                }
            }
        }

        failure {
            echo """
╔══════════════════════════════════════════════════════╗
║              ❌ PIPELINE FAILED                      ║
╚══════════════════════════════════════════════════════╝
  Build  : #${env.BUILD_NUMBER}
  Commit : ${IMAGE_TAG}
  Logs   : ${env.BUILD_URL}console

  ▶ Common causes:
    1. Maven test failure  → check surefire reports
    2. Root UID in image   → add USER in Dockerfile
    3. EC2 SSH timeout     → check security group port ${DEPLOY_PORT}
    4. Health check fail   → check app logs on EC2:
       docker logs ${APP_NAME}
══════════════════════════════════════════════════════
            """
        }

        always {
            // Always prune dangling images even if a stage crashes
            sh 'docker image prune -f || true'
        }
    }
}